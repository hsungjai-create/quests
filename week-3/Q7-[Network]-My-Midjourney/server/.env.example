# [선택] 서버 기본 API 키.
# 권장 방법은 .env가 아니라 브라우저 화면의 "API 키 설정" 패널에 키를 입력하는 것입니다.
# (그 방식은 키가 이 파일/서버 디스크에 전혀 저장되지 않아 유출 위험이 더 낮습니다.)
# 여기에 값을 채우면, 브라우저에서 키를 입력하지 않은 요청에 한해 이 키가 대신 사용됩니다.
# 발급(Google AI Studio): https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# 이미지 생성 모델 (선택, 기본값 gemini-2.5-flash-image = 나노 바나나)
# 실패 시 gemini-2.5-flash-image-preview 로 자동 재시도합니다.
GOOGLE_IMAGE_MODEL=gemini-2.5-flash-image

# 서버 포트 (선택, 기본값 3002)
PORT=3002

# 프론트엔드 개발 서버 주소 (CORS 허용, 선택, 기본값 http://localhost:5174)
CLIENT_ORIGIN=http://localhost:5174
